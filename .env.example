# ==============================================================================
# Madhav Shringar - Environment Variable Configuration Template
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# Copy this file to .env.local (for local development) or configure in your deployment provider.
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE / APPLICATION
# ------------------------------------------------------------------------------
# Base URL of the application
# Local: http://localhost:3000
# Preview: https://<preview-deployment-url>.vercel.app
# Production: https://madhavshringar.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Madhav Shringar"
NEXT_PUBLIC_APP_DESCRIPTION="Premium Spiritual & Devotional Store"

# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL - Local Development vs Production Supabase)
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT (Docker Compose or Native Postgres):
# Default Docker Compose DB port is 5433 to avoid clash with local 5432 instances.
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/shringaarwebsite?schema=public"

# PRODUCTION SUPABASE (Vercel / Bitbucket CI Deployment):
# Supabase Pooler (Next.js runtime): postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
# Supabase Direct (Prisma CLI & Migrations): postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL="postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# OPTIONAL: PRODUCTION READ-ONLY URL (For Local Backup & Catalog Sync):
# Used by `npm run db:backup` and `npm run db:sync:catalog` to populate local catalog
# PROD_DATABASE_URL="postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"
# PROD_DIRECT_URL="postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used to encrypt session tokens and JWTs (generate using: openssl rand -base64 32)
AUTH_SECRET="generate-a-secure-random-auth-secret-min-32-chars"

# 32-byte hex key for HMAC SHA-256 password hashing (generate using: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# STORE CONFIGURATION
# ------------------------------------------------------------------------------
LATEST_PRODUCT_LIMIT="4"
DEFAULT_PAYMENT_METHOD="UPI"
PAGE_SIZE="12"
USER_ROLES="user,admin"

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY - RAZORPAY
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_razorpay_secret"

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY - STRIPE
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY - PAYPAL
# ------------------------------------------------------------------------------
PAYPAL_API_URL="https://api.sandbox.paypal.com"
PAYPAL_CLIENT_ID="mock_paypal_client_id"
PAYPAL_APP_SECRET="mock_paypal_app_secret"

# ------------------------------------------------------------------------------
# EMAIL SERVICE (SMTP / Hostinger / Resend)
# ------------------------------------------------------------------------------
SENDER_EMAIL="orders@madhavshringar.com"
EMAIL_HOST="smtp.hostinger.com"
EMAIL_PORT="465"
EMAIL_USER="orders@madhavshringar.com"
EMAIL_PASS="placeholder_smtp_password"
EMAIL_FROM="Madhav Shringar <orders@madhavshringar.com>"

# ------------------------------------------------------------------------------
# FILE UPLOAD (UploadThing)
# ------------------------------------------------------------------------------
UPLOADTHING_TOKEN="placeholder_uploadthing_token"

# ------------------------------------------------------------------------------
# CRON JOBS
# ------------------------------------------------------------------------------
CRON_SECRET="placeholder_cron_secret"
